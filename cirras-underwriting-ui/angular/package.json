{
  "name": "cirras-underwriting",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "ng serve",
    "start.prod": "ng serve --configuration production --sourceMap=true",
    "build": "ng build",
    "build.prod": "ng build --configuration production --base-href /pub/cirras-underwriting/ && replace-in-file /ngsw:/g ngsw:cirras-underwriting: dist/cirras-underwriting/ngsw-worker.js --verbose --isRegex",
    "test": "ng test",
    "test-and-coverage": "ng test --browsers ChromeHeadlessCustom --watch=false --code-coverage",
    "test-dev": "ng test --reporters=mocha",
    "test-dev-chrome": "ng test --watch=true --browsers=Chrome",
    "test-dev-safari": "ng test --watch=true --browsers=Safari",
    "lint": "ng lint",
    "cr": "npm run lint && npm start.prod",
    "bundle-report": "webpack-bundle-analyzer dist/cirras-underwriting/stats.json",
    "compodoc": "npx compodoc -p src/tsconfig.app.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.35",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "@angular/material": "20.2.14",
    "@angular/material-moment-adapter": "20.2.14",
    "@angular/platform-browser": "20.3.35",
    "@angular/platform-browser-dynamic": "20.3.35",
    "@angular/router": "20.3.35",
    "@angular/service-worker": "20.3.35",
    "@busacca/ng-pick-datetime": "15.0.0",
    "@cirras/cirras-underwriting-api": "^4.2.0-SNAPSHOT",
    "@ngrx/effects": "19.2.1",
    "@ngrx/store": "19.2.1",
    "@ngrx/store-devtools": "19.2.1",
    "@bcgov/pit-common-application-lib": "^1.0.0-SNAPSHOT",
    "@bcgov/pit-common-core-lib": "^1.0.0-SNAPSHOT",
    "angular-oauth2-oidc": "19.0.0",
    "angular2-uuid": "1.1.1",
    "deep-equal": "2.2.3",
    "moment": "2.30.1",
    "multiple-select": "1.7.0",
    "ngx-connection-service": "18.0.0",
    "ngx-mask": "19.0.7",
    "ngx-moment": "6.0.2",
    "ngx-pagination": "6.0.3",
    "rxjs": "7.8.2",
    "sass": "1.95.1",
    "scroll-into-view-if-needed": "3.1.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular/build": "^20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler": "20.3.35",
    "@angular/compiler-cli": "20.3.35",
    "@angular/language-service": "20.3.35",
    "@types/node": "22.9.0",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "replace-in-file": "8.4.0",
    "ts-node": "8.10.2",
    "typescript": "5.8.3"
  }
}