{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@bcgov/pit-common-core-lib": [
        "/dist/pit-common-core-lib/types/bcgov-pit-common-core-lib.d.ts"
      ]
    },
    "experimentalDecorators": true,
    "module": "nodenext",
    "typeRoots": [
      "node_modules/@types"
    ],
    "target": "ES2022",
    "useDefineForClassFields": false
  }
}