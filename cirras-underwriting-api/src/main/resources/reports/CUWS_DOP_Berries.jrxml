<!-- Created with Jaspersoft Studio version 6.20.0.final using JasperReports Library version 6.20.0-2bc7ab61c56f459e8176eb05c7705e145cd400ad  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DOP_Berries" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e5bab596-1236-4394-bffe-7563f9e7b19c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="CUWS.jrdax"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="643"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="346"/>
	<style name="GlobalDefault" isDefault="true" fontName="Noto Sans"/>
	<parameter name="p_crop_year" class="java.lang.Integer"/>
	<parameter name="p_insurance_plan_id" class="java.lang.Integer"/>
	<parameter name="p_office_id" class="java.lang.Integer"/>
	<parameter name="p_policy_status_code" class="java.lang.String"/>
	<parameter name="p_policy_number" class="java.lang.String"/>
	<parameter name="p_grower_info" class="java.lang.String"/>
	<parameter name="p_grower_phone_number" class="java.lang.String"/>
	<parameter name="p_sort_column" class="java.lang.String"/>
	<parameter name="p_policy_ids" class="java.lang.String"/>
	<parameter name="p_top_planing_limit" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select distinct p.policy_id
		, p.contract_id
		, p.policy_number
		, p.crop_year
		, g.grower_number
		, g.grower_name	
		, g.grower_address_line1
		, g.grower_address_line2
		, g.grower_city
		, g.grower_province
		, g.grower_postal_code
		, prim_contact.grower_primary_name
		, prim_contact.grower_primary_phone
		, prim_contact.grower_primary_email	
		, ib.crop_commodity_id
		, INITCAP (cc.commodity_name) as commodity_name
		, now() as date_printed
		, case when $P{p_sort_column} = 'growerName' then g.grower_name
	       when $P{p_sort_column} = 'policyNumber' then p.policy_number
	       else p.policy_number
           end as sort_column
	from policy p
	join grower g on g.grower_id = p.grower_id
	left join (select pgc.grower_id,
			  pc.first_name || ' ' || pc.last_name as grower_primary_name,
			  pcp.phone_number as grower_primary_phone,
			  pce.email_address as grower_primary_email
		   from grower_contact pgc
		   join contact pc ON pc.contact_id = pgc.contact_id
		   left join contact_email pce on pce.contact_id = pc.contact_id
					     and pce.is_primary_email_ind = 'Y'
					     and now() between pce.effective_date and pce.expiry_date
		   left join contact_phone pcp on pcp.contact_id = pc.contact_id
					     and pcp.is_primary_phone_ind = 'Y'
					     and now() between pcp.effective_date and pcp.expiry_date
		   where pgc.is_primary_contact_ind = 'Y'
        ) prim_contact on prim_contact.grower_id = g.grower_id
	join grower_contract_year gcy on gcy.contract_id = p.contract_id 
								 and gcy.crop_year = p.crop_year
	join inventory_contract ic on ic.contract_id = gcy.contract_id
							  and ic.crop_year = gcy.crop_year
	join contracted_field_detail cfd on cfd.grower_contract_year_id = gcy.grower_contract_year_id
	join annual_field_detail afd on afd.annual_field_detail_id = cfd.annual_field_detail_id
	join field f on afd.field_id = f.field_id
	left join legal_land ll on ll.legal_land_id = afd.legal_land_id
	join inventory_field ifd on ifd.field_id = f.field_id
							and ifd.insurance_plan_id = gcy.insurance_plan_id
							and ifd.crop_year = afd.crop_year
	join inventory_berries ib on ib.inventory_field_guid = ifd.inventory_field_guid
	join crop_commodity cc on cc.crop_commodity_id = ib.crop_commodity_id
	where $P{p_policy_ids} is not null and char_length($P{p_policy_ids}) > 0
		and p.policy_id::text in (select regexp_split_to_table($P{p_policy_ids}, ','))
		and ib.planted_acres > 0
	union
	--POLICY AND FIELDS WITH FILTER
	select distinct p.policy_id
		, p.contract_id
		, p.policy_number
		, p.crop_year
		, g.grower_number
		, g.grower_name	
		, g.grower_address_line1
		, g.grower_address_line2
		, g.grower_city
		, g.grower_province
		, g.grower_postal_code	
		, prim_contact.grower_primary_name
		, prim_contact.grower_primary_phone
		, prim_contact.grower_primary_email	
		, ib.crop_commodity_id
		, INITCAP (cc.commodity_name) as commodity_name
		, now() as date_printed
		, case when $P{p_sort_column} = 'growerName' then g.grower_name
	       when $P{p_sort_column} = 'policyNumber' then p.policy_number
	       else p.policy_number
           end as sort_column
	from policy p
	join grower g on g.grower_id = p.grower_id
	left join (select pgc.grower_id,
			  pc.first_name || ' ' || pc.last_name as grower_primary_name,
			  pcp.phone_number as grower_primary_phone,
			  pce.email_address as grower_primary_email
		   from grower_contact pgc
		   join contact pc ON pc.contact_id = pgc.contact_id
		   left join contact_email pce on pce.contact_id = pc.contact_id
					     and pce.is_primary_email_ind = 'Y'
					     and now() between pce.effective_date and pce.expiry_date
		   left join contact_phone pcp on pcp.contact_id = pc.contact_id
					     and pcp.is_primary_phone_ind = 'Y'
					     and now() between pcp.effective_date and pcp.expiry_date
		   where pgc.is_primary_contact_ind = 'Y'
        ) prim_contact on prim_contact.grower_id = g.grower_id
	join grower_contract_year gcy on gcy.contract_id = p.contract_id 
								 and gcy.crop_year = p.crop_year
	join inventory_contract ic on ic.contract_id = gcy.contract_id
							  and ic.crop_year = gcy.crop_year
	join contracted_field_detail cfd on cfd.grower_contract_year_id = gcy.grower_contract_year_id
	join annual_field_detail afd on afd.annual_field_detail_id = cfd.annual_field_detail_id
	join field f on afd.field_id = f.field_id
	left join legal_land ll on ll.legal_land_id = afd.legal_land_id
	join inventory_field ifd on ifd.field_id = f.field_id
							and ifd.insurance_plan_id = gcy.insurance_plan_id
							and ifd.crop_year = afd.crop_year
	join inventory_berries ib on ib.inventory_field_guid = ifd.inventory_field_guid
	join crop_commodity cc on cc.crop_commodity_id = ib.crop_commodity_id
	left join grower_contact gc on gc.grower_id = g.grower_id 
	left join contact c on c.contact_id = gc.contact_id
	left join contact_email ce on ce.contact_id = c.contact_id
	left join contact_phone cp on cp.contact_id = c.contact_id
	where ib.planted_acres > 0
	  and ($P{p_policy_ids} is null or char_length($P{p_policy_ids}) = 0)
		and
		(
			case
				when $P{p_crop_year} is not null then p.crop_year = $P{p_crop_year}
				else true
			end
		) 
		and 
		(
			case
				when $P{p_insurance_plan_id} is not null then p.insurance_plan_id = $P{p_insurance_plan_id}
				else true
			end
		) 
		and 
		(
			case
				when $P{p_policy_status_code} is not null and char_length($P{p_policy_status_code}) > 0 then p.policy_status_code = $P{p_policy_status_code}
				else true
			end
		) 
		and 
		(
			case
				when $P{p_office_id} is not null then p.office_id = $P{p_office_id}
				else true
			end
		) 
		and 
		(
			case
				when $P{p_policy_number} is not null and char_length($P{p_policy_number}) > 0 then p.policy_number like $P{p_policy_number}
				else true
			end
		) 
		and 
		(
			case
				when $P{p_grower_info} is not null and char_length($P{p_grower_info}) > 0 
				then 
					g.grower_number::text like $P{p_grower_info}
					or upper(g.grower_name) like $P{p_grower_info}
					or upper(ce.email_address) like $P{p_grower_info}
					or
					(
						case
						when $P{p_grower_phone_number} is not null and char_length($P{p_grower_phone_number}) > 0 
						then 
							cp.phone_number like $P{p_grower_phone_number}
						else false
					end
					)
				else true
			end
		)
order by sort_column
		, policy_number
		, commodity_name]]>
	</queryString>
	<field name="policy_id" class="java.lang.Integer"/>
	<field name="contract_id" class="java.lang.Integer"/>
	<field name="policy_number" class="java.lang.String"/>
	<field name="crop_year" class="java.lang.Integer"/>
	<field name="grower_number" class="java.lang.Integer"/>
	<field name="grower_name" class="java.lang.String"/>
	<field name="grower_address_line1" class="java.lang.String"/>
	<field name="grower_address_line2" class="java.lang.String"/>
	<field name="grower_city" class="java.lang.String"/>
	<field name="grower_province" class="java.lang.String"/>
	<field name="grower_postal_code" class="java.lang.String"/>
	<field name="grower_primary_name" class="java.lang.String"/>
	<field name="grower_primary_phone" class="java.lang.String"/>
	<field name="grower_primary_email" class="java.lang.String"/>
	<field name="crop_commodity_id" class="java.lang.Integer"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="date_printed" class="java.sql.Date"/>
	<field name="sort_column" class="java.lang.String"/>
	<group name="Group1" keepTogether="true">
